{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "black-damagochi",
  "version": "0.1.0",
  "identifier": "com.blackdamagochi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Black Damagochi",
        "width": 200,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RTgzODBCNDRCQUIxMkMKUldRc3NicEVDempveDhVamVHRjNpbWR4OEw1cldrdzFMNVhQUXErUlJkWTYyMUVxRVljSXRTMHcK",
      "endpoints": [
        "https://raw.githubusercontent.com/juheeNam/black_damagochi/main/updater/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
